// 纯 BANG C kernel + 启动器（cncc 编译，只允许 C++11 级别语法，不含框架头）。
// 框架集成见同目录 softmax.cc。
// 语义对应上游 src/kernels/cuda/softmax.cu（沿 dim 的 max/和归约 + 归一化）。
// 简化策略（正确性优先）：一行一个核串行归约，全程 FP32 中间精度，顺序确定。

#include <stdint.h>

#include <bang.h>

#include "kernels/mlu_kernel_api.h"

namespace {
using infini_train::kernels::mlu::MluScalarType;

constexpr uint32_t kDefaultTaskCount = 4;

// 注意（实测）：本工具链下 taskIdX/coreId/taskDimX/coreDim 与预期语义不符，配合
// cnrtFuncTypeUnion1 时循环写 GDRAM 只有首尾元素落盘。厂商示例（samples/BANG/.../
// vectoradd/0_scalarAdd_single_core）用的是纯串行循环 + cnrtFuncTypeBlock。
// 因此所有 kernel 统一改为单任务串行；性能优化属任务三，届时再按官方多核范式改写。

// 行 = (group, inner_idx) 组合，共 outer_size * inner_size 行
template <typename T>
__mlu_global__ void SoftmaxForwardKernel(T *output, const T *input, int64_t outer_size, int64_t axis_size,
                                         int64_t inner_size) {
    const int64_t rows = outer_size * inner_size;
    for (int64_t row = 0; row < rows; ++row) {
        const int64_t group = row / inner_size;
        const int64_t inner_idx = row % inner_size;
        const int64_t base = group * axis_size * inner_size + inner_idx;

        float row_max = -__builtin_inff();
        for (int64_t axis = 0; axis < axis_size; ++axis) {
            const float v = static_cast<float>(input[base + axis * inner_size]);
            row_max = v > row_max ? v : row_max;
        }
        float row_sum = 0.0f;
        for (int64_t axis = 0; axis < axis_size; ++axis) {
            const int64_t idx = base + axis * inner_size;
            const float e = expf(static_cast<float>(input[idx]) - row_max);
            output[idx] = static_cast<T>(e);
            row_sum += e;
        }
        for (int64_t axis = 0; axis < axis_size; ++axis) {
            const int64_t idx = base + axis * inner_size;
            output[idx] = static_cast<T>(static_cast<float>(output[idx]) / row_sum);
        }
    }
}

template <typename T>
__mlu_global__ void SoftmaxBackwardKernel(T *grad_input, const T *grad_output, const T *output, int64_t outer_size,
                                          int64_t axis_size, int64_t inner_size) {
    const int64_t rows = outer_size * inner_size;
    for (int64_t row = 0; row < rows; ++row) {
        const int64_t group = row / inner_size;
        const int64_t inner_idx = row % inner_size;
        const int64_t base = group * axis_size * inner_size + inner_idx;

        float row_sum = 0.0f;
        for (int64_t axis = 0; axis < axis_size; ++axis) {
            const int64_t idx = base + axis * inner_size;
            row_sum += static_cast<float>(grad_output[idx]) * static_cast<float>(output[idx]);
        }
        for (int64_t axis = 0; axis < axis_size; ++axis) {
            const int64_t idx = base + axis * inner_size;
            grad_input[idx]
                = static_cast<T>(static_cast<float>(output[idx]) * (static_cast<float>(grad_output[idx]) - row_sum));
        }
    }
}

template <typename T>
void SoftmaxForwardTyped(void *output, const void *input, int64_t outer_size, int64_t axis_size, int64_t inner_size,
                         cnrtQueue_t queue) {
    const cnrtDim3_t dim = {1, 1, 1};
    SoftmaxForwardKernel<T><<<dim, cnrtFuncTypeBlock, queue>>>(static_cast<T *>(output), static_cast<const T *>(input),
                                                               outer_size, axis_size, inner_size);
}

template <typename T>
void SoftmaxBackwardTyped(void *grad_input, const void *grad_output, const void *output, int64_t outer_size,
                          int64_t axis_size, int64_t inner_size, cnrtQueue_t queue) {
    const cnrtDim3_t dim = {1, 1, 1};
    SoftmaxBackwardKernel<T>
        <<<dim, cnrtFuncTypeBlock, queue>>>(static_cast<T *>(grad_input), static_cast<const T *>(grad_output),
                                            static_cast<const T *>(output), outer_size, axis_size, inner_size);
}

#define MLU_SM_FLOAT_SWITCH(fn, ...)                                                                                   \
    switch (type) {                                                                                                    \
    case MluScalarType::kF16:                                                                                          \
        fn<half>(__VA_ARGS__);                                                                                         \
        return;                                                                                                        \
    case MluScalarType::kBF16:                                                                                         \
        fn<bfloat16_t>(__VA_ARGS__);                                                                                   \
        return;                                                                                                        \
    case MluScalarType::kF32:                                                                                          \
        fn<float>(__VA_ARGS__);                                                                                        \
        return;                                                                                                        \
    default:                                                                                                           \
        return;                                                                                                        \
    }
} // namespace

namespace infini_train::kernels::mlu {

void SoftmaxForwardLaunch(void *output, const void *input, int64_t outer_size, int64_t axis_size, int64_t inner_size,
                          MluScalarType type, cnrtQueue_t queue) {
    MLU_SM_FLOAT_SWITCH(SoftmaxForwardTyped, output, input, outer_size, axis_size, inner_size, queue)
}

void SoftmaxBackwardLaunch(void *grad_input, const void *grad_output, const void *output, int64_t outer_size,
                           int64_t axis_size, int64_t inner_size, MluScalarType type, cnrtQueue_t queue) {
    MLU_SM_FLOAT_SWITCH(SoftmaxBackwardTyped, grad_input, grad_output, output, outer_size, axis_size, inner_size, queue)
}

} // namespace infini_train::kernels::mlu
