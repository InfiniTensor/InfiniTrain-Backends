// 设备侧标量数学函数单测：确认哪些函数在 MLU590 上返回错误值。
// 独立于框架，直接用 cnrt + cncc 编译运行（见同目录 build_and_run.sh）。
//
// 背景：PowForward 曾整片 NaN → 证实设备侧 powf 不可用；softmax 输出不在 [0,1]
// → 怀疑 expf/tanhf。本测试把候选函数逐个与 host std:: 版本对拍。

#include <stdint.h>

#include <bang.h>

// 与 host 侧约定的算子编号
enum MathOp : int {
    kExp = 0,
    kLog = 1,
    kTanh = 2,
    kSqrt = 3,
    kRsqrt = 4,
    kPow3 = 5,
    kIdentity = 6,
    kOpCount = 7,
};

// 最小探针：不依赖任何数学函数和循环，只写常量，用来验证 launch 机制本身
__mlu_global__ void ProbeKernel(float *out, int64_t n) {
    if (taskIdX == 0 && coreId == 0) {
        out[0] = 42.0f;
    }
    if (taskIdX == 1 && coreId == 0) {
        out[1] = -7.5f;
    }
    out[n - 1] = 1.0f;
}

template <int Op> __mlu_func__ float Eval(float x) {
    if (Op == kExp) {
        return expf(x);
    }
    if (Op == kLog) {
        return logf(x);
    }
    if (Op == kTanh) {
        return tanhf(x);
    }
    if (Op == kSqrt) {
        return sqrtf(x);
    }
    if (Op == kRsqrt) {
        return 1.0f / sqrtf(x);
    }
    if (Op == kIdentity) {
        return x;
    }
    return powf(x, 3.0f);
}

template <int Op> __mlu_global__ void MathKernel(const float *in, float *out, int64_t n) {
    // 纯串行：不使用 taskIdX/coreId/taskDimX/coreDim（这些内建量在本工具链下
    // 与预期不符，见 probe3 对照），由调用方按 Block/单任务启动
    for (int64_t i = 0; i < n; ++i) { out[i] = Eval<Op>(in[i]); }
}

template <int Op> void LaunchTyped(const float *in, float *out, int64_t n, cnrtQueue_t queue) {
    const cnrtDim3_t dim = {1, 1, 1}; // 厂商示例用 Block；Union1 下循环写不落盘
    MathKernel<Op><<<dim, cnrtFuncTypeBlock, queue>>>(in, out, n);
}

void ProbeLaunch(void *out, int64_t n, cnrtQueue_t queue) {
    const cnrtDim3_t dim = {4, 1, 1};
    ProbeKernel<<<dim, cnrtFuncTypeUnion1, queue>>>(static_cast<float *>(out), n);
}

void MathSelftestLaunch(const void *in, void *out, int64_t n, int op, cnrtQueue_t queue) {
    switch (op) {
    case kExp:
        LaunchTyped<kExp>(static_cast<const float *>(in), static_cast<float *>(out), n, queue);
        return;
    case kLog:
        LaunchTyped<kLog>(static_cast<const float *>(in), static_cast<float *>(out), n, queue);
        return;
    case kTanh:
        LaunchTyped<kTanh>(static_cast<const float *>(in), static_cast<float *>(out), n, queue);
        return;
    case kSqrt:
        LaunchTyped<kSqrt>(static_cast<const float *>(in), static_cast<float *>(out), n, queue);
        return;
    case kRsqrt:
        LaunchTyped<kRsqrt>(static_cast<const float *>(in), static_cast<float *>(out), n, queue);
        return;
    case kPow3:
        LaunchTyped<kPow3>(static_cast<const float *>(in), static_cast<float *>(out), n, queue);
        return;
    case kIdentity:
        LaunchTyped<kIdentity>(static_cast<const float *>(in), static_cast<float *>(out), n, queue);
        return;
    default:
        return;
    }
}

// 进一步切分：mode 0 = 按下标算值（不读输入）；mode 1 = 读 in[0] 广播；mode 2 = 读 in[i]
__mlu_global__ void Probe2Kernel(const float *in, float *out, int64_t n, int mode) {
    const int64_t stride = static_cast<int64_t>(taskDimX) * coreDim;
    for (int64_t i = static_cast<int64_t>(taskIdX) * coreDim + coreId; i < n; i += stride) {
        if (mode == 0) {
            out[i] = static_cast<float>(i) * 0.5f;
        } else if (mode == 1) {
            out[i] = in[0];
        } else {
            out[i] = in[i];
        }
    }
}

void Probe2Launch(const void *in, void *out, int64_t n, int mode, cnrtQueue_t queue) {
    const cnrtDim3_t dim = {4, 1, 1};
    Probe2Kernel<<<dim, cnrtFuncTypeUnion1, queue>>>(static_cast<const float *>(in), static_cast<float *>(out), n,
                                                     mode);
}

// 决定性对照：单任务、不依赖 taskIdX/coreDim，纯串行写 0..n-1
__mlu_global__ void Probe3Kernel(const float *in, float *out, int64_t n) {
    for (int64_t i = 0; i < n; ++i) { out[i] = in[i]; }
}

void Probe3Launch(const void *in, void *out, int64_t n, cnrtQueue_t queue) {
    const cnrtDim3_t dim = {1, 1, 1};
    // 厂商 vectoradd 示例用的是 cnrtFuncTypeBlock
    Probe3Kernel<<<dim, cnrtFuncTypeBlock, queue>>>(static_cast<const float *>(in), static_cast<float *>(out), n);
}

// 微测试：单任务、纯常量写（无循环）
__mlu_global__ void Probe4Kernel(float *out) {
    out[0] = 7.0f;
    out[5] = 8.0f;
}

// 微测试：单任务、单次循环（n 很小）
__mlu_global__ void Probe5Kernel(const float *in, float *out, int64_t n) {
    for (int64_t i = 0; i < n; ++i) { out[i] = in[i]; }
}

void Probe4Launch(void *out, cnrtQueue_t queue) {
    const cnrtDim3_t dim = {1, 1, 1};
    Probe4Kernel<<<dim, cnrtFuncTypeUnion1, queue>>>(static_cast<float *>(out));
}

void Probe5Launch(const void *in, void *out, int64_t n, cnrtQueue_t queue) {
    const cnrtDim3_t dim = {1, 1, 1};
    Probe5Kernel<<<dim, cnrtFuncTypeUnion1, queue>>>(static_cast<const float *>(in), static_cast<float *>(out), n);
}
