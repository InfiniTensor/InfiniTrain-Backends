                infini_train::kernels::maca::MatmulForward)
REGISTER_KERNEL(infini_train::Device::DeviceType::kPrivateUse1, MatmulBackwardInput,
                infini_train::kernels::maca::MatmulBackwardInput)
REGISTER_KERNEL(infini_train::Device::DeviceType::kPrivateUse1, MatmulBackwardOther,
                infini_train::kernels::maca::MatmulBackwardOther)
REGISTER_KERNEL(infini_train::Device::DeviceType::kPrivateUse1, LinearForward,
                infini_train::kernels::maca::LinearForward)
REGISTER_KERNEL(infini_train::Device::DeviceType::kPrivateUse1, LinearBackwardInput,
                infini_train::kernels::maca::LinearBackwardInput)
REGISTER_KERNEL(infini_train::Device::DeviceType::kPrivateUse1, LinearBackwardWeight,
                infini_train::kernels::maca::LinearBackwardWeight)
REGISTER_KERNEL(infini_train::Device::DeviceType::kPrivateUse1, LinearBackwardBias,
                infini_train::kernels::maca::LinearBackwardBias)

} // namespace infini_train::kernels::maca
